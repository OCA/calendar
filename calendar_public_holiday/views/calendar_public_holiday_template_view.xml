<odoo>
    <record id="view_calendar_public_holiday_template_list" model="ir.ui.view">
        <field name="name">calendar.public.holiday.template.list</field>
        <field name="model">calendar.public.holiday.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="country_id" />
            </list>
        </field>
    </record>
    <record id="view_calendar_public_holiday_template_form" model="ir.ui.view">
        <field name="name">calendar.public.holiday.template.form</field>
        <field name="model">calendar.public.holiday.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_generate_public_holidays"
                        string="Generate Holidays"
                        type="object"
                        class="btn-primary"
                    />
                </header>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <group name="group_main">
                        <group name="group_main_left">
                            <field name="name" />
                            <field name="country_id" />
                            <field name="active" invisible="1" />
                        </group>
                        <group name="group_main_right">
                            <field name="generate_year" options="{'type': 'number'}" />
                        </group>
                    </group>
                    <separator string="Public Holidays" name="group_detail" />
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="name" />
                            <field name="date_type" />
                            <field
                                name="date"
                                invisible="date_type != 'fixed'"
                                required="date_type == 'fixed'"
                            />
                            <field name="day_offset" />
                            <field
                                name="state_ids"
                                widget="many2many_tags"
                                domain="[('country_id', '=', parent.country_id)]"
                            />
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_calendar_public_holiday_template_search" model="ir.ui.view">
        <field name="name">calendar.public.holiday.template.search</field>
        <field name="model">calendar.public.holiday.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="country_id" />
                <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>
    <record
        id="open_calendar_public_holiday_template_view"
        model="ir.actions.act_window"
    >
        <field name="name">Public Holiday Templates</field>
        <field name="res_model">calendar.public.holiday.template</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        action="open_calendar_public_holiday_template_view"
        id="menu_calendar_public_holiday_template_view"
        parent="menu_calendar_public_holiday"
        sequence="62"
    />
</odoo>

<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="resource_calendar_form_view" model="ir.ui.view">
        <field name="name">resource.calendar.form.public.holiday</field>
        <field name="model">resource.calendar</field>
        <field name="inherit_id" ref="resource.resource_calendar_form" />
        <field name="arch" type="xml">
            <group name="switch_calendar" position="after">
                <group
                    string="Public Holiday Templates"
                    name="public_holidays"
                    colspan="2"
                >
                    <field name="public_holiday_employee_sync" />
                </group>
            </group>
            <notebook position="inside">
                <page string="Public Holidays" name="public_holidays">
                    <field name="public_holiday_overview_line_ids">
                        <list
                            default_order="date desc"
                            default_group_by="public_holiday_id"
                        >
                            <field name="date" />
                            <field name="name" />
                            <field name="public_holiday_id" column_invisible="1" />
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
</odoo>

<?xml version="1.0" ?>
<odoo>

    <record id="view_calendar_event_form" model="ir.ui.view">
        <field name="name">calendar.event.form - microsoft_calendar_logging</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form" />
        <field name="priority" eval="256" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page>
                    <group name="group_ms_calendar_logging" colspan="4" col="2">
                        <field name="create_date" />
                        <field name="created_by_synchronization" />
                        <field name="datetime_created_on_microsoft" />
                        <field name="datetime_updated_from_microsoft" />
                        <field name="datetime_updated_on_microsoft" />
                    </group>
                </page>
            </notebook>
        </field>
    </record>

</odoo>

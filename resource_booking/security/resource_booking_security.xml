<data>
    <record id="category_resource_booking" model="ir.module.category">
        <field name="name">Resource Booking</field>
    </record>
    <record id="group_user" model="res.groups">
        <field name="name">User</field>
        <field name="comment">Users allowed to book resources</field>
    </record>
    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_user'))]" />
        <field
            name="comment"
        >Users allowed to manage resource booking configurations.</field>
        <field
            name="user_ids"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>
    <data noupdate="1">
        <!-- In Odoo 20, an `ir.access` record without a group is a
             restriction (AND-ed with the permissions), while a record with a
             group is a permission (OR-ed with the other permissions of the
             user). Group-specific rules from `ir.rule` therefore cannot stay
             here: their domains live on the matching permission in
             `ir.access.csv`. Only the global (all-users) rules remain. -->
        <record id="rule_resource_booking_type_company" model="ir.access">
            <field name="name">Resource booking type multi company rule</field>
            <field name="operation">crud</field>
            <field name="model_id" ref="model_resource_booking_type" />
            <field name="domain">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="rule_resource_booking_company" model="ir.access">
            <field name="name">Resource booking multi company rule</field>
            <field name="operation">crud</field>
            <field name="model_id" ref="model_resource_booking" />
            <field
                name="domain"
            >[('type_id.company_id', 'in', company_ids + [False])]</field>
        </record>
    </data>
</data>

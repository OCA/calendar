<odoo>
    <record id="resource_booking_type_view_form" model="ir.ui.view">
        <field name="name">Resource booking type form - resource_booking_crm</field>
        <field name="model">resource.booking.type</field>
        <field
            name="inherit_id"
            ref="resource_booking.resource_booking_type_view_form"
        />
        <field name="arch" type="xml">
            <group name="event_defaults" position="after">
                <group name="crm" string="CRM">
                    <field name="crm_lead_type" />
                    <field name="crm_team_id" invisible="not crm_lead_type" />
                    <field name="crm_user_id" invisible="not crm_lead_type" />
                    <field
                        name="crm_tag_ids"
                        widget="many2many_tags"
                        options="{'color_field': 'color'}"
                        invisible="not crm_lead_type"
                    />
                    <field name="crm_lead_reuse" invisible="not crm_lead_type" />
                </group>
            </group>
        </field>
    </record>
</odoo>
